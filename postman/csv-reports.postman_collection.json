{
  "info": {
    "name": "CSV Import & Reports API",
    "description": "Run the requests top to bottom. IDs are captured into collection variables automatically. Imports and reports are asynchronous: re-send the GET requests until the status is terminal (a report takes ~5s with the default compose settings).\n\nFor the upload requests, pick the file from the repository's samples/ folder if Postman cannot resolve the relative path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "alice"
    },
    {
      "key": "importId",
      "value": ""
    },
    {
      "key": "badImportId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Imports",
      "item": [
        {
          "name": "Upload sample CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Optional. Re-using a key returns the original import."
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports"
              ]
            },
            "description": "Returns immediately with a queued import job.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/orders_sample.csv",
                  "description": "Select the CSV from the samples/ folder"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('importId', pm.response.json().import_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get import status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports/{{importId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{importId}}"
              ]
            },
            "description": "Re-send until status is completed / completed_with_errors / failed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "console.log('status =', pm.response.json().status);"
                ]
              }
            }
          ]
        },
        {
          "name": "List invalid rows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports/{{importId}}/errors?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{importId}}",
                "errors"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Download original file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports/{{importId}}/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{importId}}",
                "file"
              ]
            },
            "description": "Served from object storage (SeaweedFS). Returns 410 after the file was removed with storage-admin."
          }
        },
        {
          "name": "List my imports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Upload file with bad header (fails permanently)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/orders_bad_header.csv",
                  "description": "Select the CSV from the samples/ folder"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('badImportId', pm.response.json().import_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get failed import status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports/{{badImportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{badImportId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Upload file with many invalid rows",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/orders_many_errors.csv",
                  "description": "Select the CSV from the samples/ folder"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Request report (selected imports)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "description": "Returns immediately. Omit the body to include all your completed imports.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"import_ids\": [\n    \"{{importId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('reportId', pm.response.json().report_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Request report (all completed imports)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reportId', pm.response.json().report_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get report status / summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}"
              ]
            },
            "description": "Re-send until status is completed. The summary (totals) is embedded; the full report is a file in object storage (see the download requests)."
          }
        },
        {
          "name": "Download report (CSV)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/download?format=csv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}",
                "download"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Download report (JSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/download?format=json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}",
                "download"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "List my reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "Missing X-User-Id -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/imports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports"
              ]
            }
          }
        },
        {
          "name": "Other user's import -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "mallory"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/imports/{{importId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{importId}}"
              ]
            }
          }
        },
        {
          "name": "Report on an unfinished/failed import -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"import_ids\": [\"{{badImportId}}\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}